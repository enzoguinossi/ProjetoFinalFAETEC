@startuml
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction

' =========================================================
' CÓDIGOS PERSONALIZADOS
' =========================================================
package "Códigos Personalizados" as Codigos {
  class TipoCodigo {
    + ID_tipo_codigo: Integer
    + nome: String
    + descricao: String
    + ativo: Boolean
  }

  class ProdutoCodigo {
    + ID_produto_codigo: Integer
    + codigo: String
  }

  class DestinatarioCodigo {
    + ID_dest_codigo: Integer
    + codigo: String
  }

  class FornecedorCodigo {
    + ID_forn_codigo: Integer
    + codigo: String
  }

  class FuncionarioCodigo {
    + ID_func_codigo: Integer
    + codigo: String
  }

  class VeiculoCodigo {
    + ID_veic_codigo: Integer
    + codigo: String
  }

  TipoCodigo "1" -- "*" ProdutoCodigo : "tipo >"
  TipoCodigo "1" -- "*" DestinatarioCodigo
  TipoCodigo "1" -- "*" FornecedorCodigo
  TipoCodigo "1" -- "*" FuncionarioCodigo
  TipoCodigo "1" -- "*" VeiculoCodigo
}

' =========================================================
' PESSOAS
' =========================================================
package "Pessoas" as Pessoas {
  class PessoaFisica {
    + ID_pessoa_fisica: Integer
    + nome: String
    + cpf: String [opcional]
    + ativo: Boolean
  }

  class PessoaJuridica {
    + ID_pessoa_juridica: Integer
    + razao_social: String
    + cnpj: String [opcional]
    + ativo: Boolean
  }
}

' =========================================================
' FUNCIONÁRIOS, USUÁRIOS, CONDUTORES
' =========================================================
package "Funcionários" as Funcionarios {
  class Funcionario {
    + ID_funcionario: Integer
    + cargo: String
    + condutor: Boolean
    + ativo: Boolean
  }

  class Usuario {
      + ID_usuario: Integer
      + login: String
      + senha_hash: String [opcional até o 1º acesso]
      + senha_alterada_em: Timestamp
      + super_admin: Boolean
      + ultimo_acesso: Timestamp
      + ativo: Boolean
    }

  Funcionario "1" <-- "1" Usuario : extensão >
}

' =========================================================
' FORNECEDORES E DESTINATÁRIOS
' =========================================================
package "Cadastros" as Cadastros {
  class Fornecedor {
    + ID_fornecedor: Integer
    + contato: String
    + ativo: Boolean
  }

  class Destinatario {
    + ID_destinatario: Integer
    + tipo_destinatario: Enum
    + ativo: Boolean
  }
}

' Relacionamentos Pessoas
PessoaFisica "1" <-- "1" Funcionario : é uma >
PessoaJuridica "1" <-- "1" Fornecedor : é uma >
PessoaJuridica "1" <-- "1" Destinatario : é uma >

' =========================================================
' CONTATO E ENDEREÇO
' =========================================================
package "Contato" as Contato {
  class Endereco {
    + ID_endereco: Integer
    + logradouro: String
    + numero: String
    + complemento: String
    + bairro: String
    + cidade: String
    + uf: String
    + cep: String
    + latitude: Float
    + longitude: Float
  }

  class FuncionarioTelefone {
    + numero: String
    + tipo: Enum
    + principal: Boolean
  }

  class DestinatarioTelefone {
    + numero: String
    + tipo: Enum
    + principal: Boolean
  }

  class FornecedorTelefone {
    + numero: String
    + tipo: Enum
    + principal: Boolean
  }

  class FuncionarioEmail {
    + endereco: String
    + principal: Boolean
  }

  class DestinatarioEmail {
    + endereco: String
    + principal: Boolean
  }

  class FornecedorEmail {
    + endereco: String
    + principal: Boolean
  }
}

Funcionario "1" --> "*" FuncionarioTelefone : possui >
Funcionario "1" --> "*" FuncionarioEmail : possui >
Destinatario "1" --> "*" DestinatarioTelefone : possui >
Destinatario "1" --> "*" DestinatarioEmail : possui >
Fornecedor "1" --> "*" FornecedorTelefone : possui >
Fornecedor "1" --> "*" FornecedorEmail : possui >
Destinatario "1" --> "1" Endereco : localiza-se >
Fornecedor "1" --> "0..1" Endereco : localiza-se >

' =========================================================
' PRODUTOS E ESTOQUE
' =========================================================
package "Produtos e Estoque" as Produtos {

  class ConversaoUnidade {
    + ID_conversao: Integer
    + nome: String
    + fator: Float
  }

  class Produto {
      + ID_produto: Integer
      + descricao: String
      + foto_url: String
      + perecivel: Boolean
      + composto: Boolean
      + data_validade: Date
      + ativo: Boolean
    }

  class ProdutoInsumo {
    + ID_produto_insumo: Integer
    + quantidade: Float
    + ativo: Boolean
  }

  class Estoque {
      + ID_estoque: Integer
      + quantidade_atual: Float
      + saldo_reservado: Float
      + data_entrada: Date
      + ativo: Boolean
    }

  class Inventario {
      + ID_inventario: Integer
      + data_inicio: Date
      + data_fim: Date
      + contagem_cega: Boolean
      + status: Enum
      + ID_usuario_abertura: Integer
      + ID_usuario_aprovacao: Integer
    }

    class ItemInventario {
      + ID_item_inventario: Integer
      + quantidade_sistema: Float
    }

    class ContagemInventario {
      + ID_contagem_inventario: Integer
      + quantidade_contada: Float
      + data_contagem: Timestamp
    }

    class AjusteInventario {
      + ID_ajuste_inventario: Integer
      + diferenca: Float
      + status: Enum
    }

  class MovimentacaoEstoque {
      + ID_movimentacao: Integer
      + quantidade: Float
      + saldo_anterior: Float
      + saldo_posterior: Float
      + ID_nota_entrada: Integer
      + ID_nota_saida: Integer
      + ID_remessa: Integer
      + data_hora: Timestamp
      + observacao: Text
    }

  class ReservaEstoque {
      + ID_reserva_estoque: Integer
      + quantidade: Float
      + saldo_anterior: Float
      + saldo_posterior: Float
      + data_hora: Timestamp
      + observacao: Text
    }
}

Produto "1" --> "0..*" Estoque : estocado em >
Produto "1" --> "0..*" ProdutoInsumo : pai de >
Produto "1" <-- "*" ProdutoInsumo : filho de >
ConversaoUnidade "1" --> "0..*" Produto : conversão padrão >
Estoque "1" --> "*" MovimentacaoEstoque : movimenta >
Estoque "1" --> "*" ReservaEstoque : reserva >
NotaSaida "1" --> "*" ReservaEstoque : origina >
Usuario "1" --> "*" MovimentacaoEstoque : registra >
Usuario "1" --> "*" ReservaEstoque : registra >
Inventario "1" --> "*" ItemInventario : contém >
ItemInventario "1" --> "*" ContagemInventario : contada em >
Funcionario "1" --> "*" ContagemInventario : realiza >
Inventario "1" --> "*" AjusteInventario : gera >
Estoque "1" --> "*" AjusteInventario : ajustado em >
Estoque "1" --> "*" ItemInventario : contado em >

' Códigos dos produtos
Produto "1" --> "*" ProdutoCodigo : possui >

' =========================================================
' NOTAS, REMESSAS E ROTAS
' =========================================================
package "Logística" as Logistica {

  class PedidoEscola {
      + ID_pedido_escola: Integer
      + data_criacao: Timestamp
      + status: Enum
      + observacao: Text
    }

    class ItemPedidoEscola {
      + ID_item_pedido_escola: Integer
      + quantidade: Float
    }

    class NotaSaida {
          + ID_nota_saida: Integer
          + ID_pedido_escola: Integer
          + data_criacao: Timestamp
          + tipo: Enum
          + status: Enum
          + observacao: Text
          + ativo: Boolean
        }

        class ItemNotaSaida {
          + ID_item_nota_saida: Integer
          + qtd_esperada: Float
          + qtd_entregue: Float
        }

      class Remessa {
      + ID_remessa: Integer
      + data_criacao: Timestamp
      + status: Enum
      + urgente: Boolean
      + observacao: Text
    }

    class ItemRemessa {
      + ID_item_remessa: Integer
      + quantidade_solicitada: Float
      + quantidade_separada: Float
      + quantidade_entregue: Float
    }

    class Coleta {
      + ID_coleta: Integer
      + data_criacao: Timestamp
      + observacao: Text
    }

    class ItemColeta {
      + ID_item_coleta: Integer
      + quantidade: Float
    }

  class Percurso {
    + ID_percurso: Integer
    + nome: String
    + descricao: Text
  }

  class PercursoDestinatario {
    + ordem_visita: Integer
  }

  class Rota {
    + ID_rota: Integer
    + data_criacao: Timestamp
    + data_prevista: Date
    + observacao: Text
    + status: Enum
    + ativo: Boolean
  }

  class RotaRemessa {
    + ID_rota_remessa: Integer
    + ordem_visita: Integer
    + data_adicao: Timestamp
  }

  class Veiculo {
    + ID_veiculo: Integer
    + placa: String
    + modelo: String
    + status: Enum
    + ativo: Boolean
  }
class Anexo {
    + ID_anexo: Integer
    + nome_arquivo: String
    + url: String
    + tipo_mime: String
    + data_upload: Timestamp
    + ativo: Boolean
  }
}

PedidoEscola "1" --> "*" ItemPedidoEscola : contém >
PedidoEscola "1" --> "0..1" NotaSaida : gera >
Destinatario "1" --> "*" PedidoEscola : solicita >
NotaSaida "1" --> "*" ItemNotaSaida : contém >
NotaSaida "1" --> "*" Remessa : gera >
NotaSaida "1" --> "*" Coleta : gera >
Remessa "1" --> "*" ItemRemessa : contém >
Coleta "1" --> "*" ItemColeta : contém >
Remessa "1" --> "*" Anexo : anexa >
Estoque "1" --> "*" ItemNotaSaida : reservado em >
Estoque "1" --> "*" ItemRemessa : expedido em >
Funcionario "0..1" --> "0..*" Remessa : conduz >
Veiculo "0..1" --> "0..*" Remessa : vincula >
Rota "1" --> "*" RotaRemessa : agrupa >
Remessa "1" --> "*" RotaRemessa : alocada em >
Percurso "1" --> "*" PercursoDestinatario : define >
Destinatario "1" --> "*" PercursoDestinatario : incluso em >
Remessa "*" --> "1" Destinatario : destinada a >

' =========================================================
' NOTA DE ENTRADA
' =========================================================
package "Nota de Entrada" as NotaEntrada {
  class NotaEntrada {
    + ID_nota_entrada: Integer
    + data_criacao: Timestamp
    + tipo: Enum
    + data_recebimento: Date
    + observacao: Text
    + chave_acesso: String
    + ativo: Boolean
  }

  class ItemNotaEntrada {
    + ID_item_nota_entrada: Integer
    + fator_conversao: Float
    + quantidade: Float
    + quantidade_convertida: Float
  }
}

Fornecedor "1" --> "*" NotaEntrada : emite >
NotaEntrada "1" --> "*" ItemNotaEntrada : contém >
Produto "1" --> "*" ItemNotaEntrada : listado em >

' =========================================================
' ACESSOS E SEGURANÇA
' =========================================================
package "Acessos" as Acessos {
  class Perfil {
    + ID_perfil: Integer
    + nome: String
    + descricao: Text
    + ativo: Boolean
  }

  class Permissao {
    + ID_permissao: Integer
    + nome: String
    + descricao: Text
    + ativo: Boolean
  }

  class MensagemMural {
      + ID_mensagem_mural: Integer
      + titulo: String
      + conteudo: Text
      + data_publicacao: Timestamp
      + data_expiracao: Timestamp
      + automatica: Boolean
      + ativo: Boolean
    }

  class UsuarioPermissao {
    + ID_usuario: Integer
    + ID_permissao: Integer
  }

  class PerfilPermissao {
    + ID_perfil: Integer
    + ID_permissao: Integer
  }

  class RegistroAuditoria {
      + ID_registro_auditoria: Integer
      + data_hora: Timestamp
      + acao: String
      + entidade: String
      + ID_entidade_afetada: Integer
      + dados_anteriores: JSON
      + dados_novos: JSON
    }
}

Usuario "1" --> "*" UsuarioPermissao : possui >
Permissao "1" --> "*" UsuarioPermissao : concedida em >
Perfil "1" --> "*" PerfilPermissao : template >
Permissao "1" --> "*" PerfilPermissao : compõe >
Usuario "1" --> "*" RegistroAuditoria : realiza >
Usuario "1" --> "*" MensagemMural : publica >

@enduml