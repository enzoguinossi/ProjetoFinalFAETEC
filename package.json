    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "npm install && npm run db:setup",
    "figma:harvest": "tsx tools/figma-export/harvest.ts",
    "figma:serve": "tsx tools/figma-export/server.ts",
    "figma:check": "tsx tools/figma-export/plugin-check.ts",
    "figma:compare": "tsx tools/figma-export/compare.ts",
    "figma:diff": "tsx tools/figma-export/diff.ts",
    "figma:fixtures": "tsx tools/figma-export/fixtures.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.3.1",
