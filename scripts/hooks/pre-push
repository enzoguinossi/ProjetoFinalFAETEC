#!/usr/bin/env python3
"""
Pre-push hook: Validates all .puml files before allowing push.
If any syntax errors are found, the push is aborted.

Install: .git/hooks/pre-push
(or run: python scripts/setup_hooks.py)
"""
import os
import sys
import subprocess

REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))

if __name__ == "__main__":
    os.chdir(REPO_ROOT)
    
    # Run validate-only
    result = subprocess.run(
        [sys.executable, "scripts/build_docs.py", "--validate-only"],
        capture_output=True, text=True
    )
    
    print(result.stdout)
    
    if result.returncode != 0:
        print("\n❌ PUML validation FAILED. Push rejected.")
        print("Fix the errors above and try again.")
        print(result.stderr)
        sys.exit(1)
    
    print("✅ All diagrams valid. Push allowed.")
    sys.exit(0)