# Copy this file to `.env` and replace the placeholders with real values.
# Banco de dados MySQL (driver: @prisma/adapter-mariadb).

DATABASE_URL="mysql://user:password@localhost:3306/nexus"

# Segredo usado para assinar/verificar os JWT (HS256). Use um valor forte e único.
JWT_SECRET="troque-por-um-segredo-forte-e-unico"
