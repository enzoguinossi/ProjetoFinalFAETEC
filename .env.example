# Copy this file to `.env` and replace the placeholders with real values.
# Banco de dados MySQL (driver: @prisma/adapter-mariadb).
#
# Em produção, aponte para o banco `nexus_prod`.
# A senha do usuário do banco pode ter qualquer tamanho (até 256 caracteres),
# sem exigência de composição. Não pode conter `@`, `/`, `?`, `#`, `"`, `\`,
# `;`, espaço, tab ou caracteres de controle (quebram a URL/arquivos de opção).
# O parser de `src/lib/prisma.ts` e o instalador validam essa regra.

DATABASE_URL="mysql://user:password@localhost:3306/nexus"

# Segredo usado para assinar/verificar os JWT (HS256). Deve ser único e forte,
# gerado exclusivamente para este ambiente.
JWT_SECRET="troque-por-um-segredo-forte-e-unico"

# Opcional. Raiz física dos uploads. Em produção, use um diretório fora da
# instalação para sobreviver às atualizações (ex.: C:\ProgramData\Nexus\uploads).
# Sem esta variável, o padrão é `public/uploads` dentro do projeto.
# UPLOADS_DIR=C:\ProgramData\Nexus\uploads
