# -----------------------------------------------------------------------------
# Copie para `.env` (uso local / `npm run dev`) e ajuste os valores.
# Em qualquer ambiente Docker as variáveis são injetadas pelo ambiente — não comite `.env`.
# -----------------------------------------------------------------------------

# Banco de dados MySQL (driver: @prisma/adapter-mariadb).
# Local: use `localhost` (MySQL rodando na sua máquina).
# Docker Compose: o serviço `app` monta a URL apontando para o host `mysql`.
DATABASE_URL="mysql://nexus:nexus_password@localhost:3306/Nexus"

# Segredo usado para assinar/verificar os JWT (HS256). Use um valor forte e único.
JWT_SECRET="troque-por-um-segredo-forte-e-unico"

# -----------------------------------------------------------------------------
# Docker Compose (opcional) — usadas pelos serviços em docker-compose.yml.
# Se `DATABASE_URL` acima não for definida, o Compose a monta a partir destas.
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=Nexus
MYSQL_USER=nexus
MYSQL_PASSWORD=nexus_password
MYSQL_PORT=3306
APP_PORT=3000
